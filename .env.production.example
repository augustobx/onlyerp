MYSQL_DATABASE=onlyerp_db
MYSQL_USER=onlyerp_app
MYSQL_PASSWORD=replace-with-a-strong-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
DATABASE_URL=mysql://onlyerp_app:replace-with-a-strong-url-safe-password@db:3306/onlyerp_db

SESSION_SECRET=replace-with-at-least-32-random-hex-bytes
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password
SEED_DEMO_DATA=false

NEXT_PUBLIC_APP_URL=https://onlyerp.nanoapps.ar
PLATFORM_HOST=onlyerp.nanoapps.ar
TENANT_BASE_DOMAIN=nanoapps.ar
MOCK_AFIP=false
TZ=America/Argentina/Buenos_Aires

# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY is stored separately at:
# .secrets/next-server-actions.key (generate with: openssl rand -base64 32)
